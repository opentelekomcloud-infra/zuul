# Dockerfile for Zuul Executor with Gitea driver
FROM swr.eu-de.otc.t-systems.com/t-cloud-public/hardened-zuul-executor:13.1.1-v2

USER root

# Copy Gitea driver source files
COPY zuul/driver/gitea/ /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/
COPY zuul/lib/connections.py /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py

# Copy GitHub driver fix (merge-mode fallback for missing API fields)
COPY zuul/driver/github/githubconnection.py /usr/local/lib/python3.11/site-packages/zuul/driver/github/githubconnection.py

# Copy zuul_stream callback fix (reduced "Waiting on logger" noise)
COPY zuul/ansible/base/callback/zuul_stream.py /usr/local/lib/python3.11/site-packages/zuul/ansible/base/callback/zuul_stream.py

# Ensure the zuul user/group exists (hardened base images do not create it)
# Also create subuid/subgid entries — bwrap needs these for UID namespace
# mapping inside its sandbox. Hardened base images strip them; bwrap parses
# them in colon-separated format: name start count (e.g. "zuul:100000:65536").
#
# Also create /etc/localtime — bwrap unconditionally binds it (--ro-bind
# /etc/localtime /etc/localtime) so without it the validation call fails
# with "Failed to create bind mount: No such file or directory".
RUN groupadd -g 10001 zuul 2>/dev/null || true && \
    useradd -u 10001 -g zuul -m -d /var/lib/zuul -c "Zuul Daemon" zuul 2>/dev/null || true && \
    echo "zuul:100000:65536" > /etc/subuid && \
    echo "zuul:100000:65536" > /etc/subgid && \
# Hardened base installs zuul binaries under /opt/python/bin but CMD expects /usr/local/bin
    mkdir -p /usr/local/bin && \
    ln -sf /opt/python/bin/zuul-executor /usr/local/bin/zuul-executor && \
    ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# Ensure proper permissions
RUN chown -R zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/ && \
    chown zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py && \
    chown zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/driver/github/githubconnection.py && \
    chown zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/ansible/base/callback/zuul_stream.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/*.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/driver/github/githubconnection.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/ansible/base/callback/zuul_stream.py

USER zuul

# Verify driver can be imported
RUN python3 -c "from zuul.driver.gitea import GiteaDriver; print('Gitea driver loaded successfully')"
