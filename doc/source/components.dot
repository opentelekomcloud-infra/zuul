// dot -Tpng -ocomponents.png components.dot
digraph {
  compound=true;
  node [shape=box]
  Database [shape=cylinder]
  Finger [href="#finger-gateway"]
  Statsd [shape=ellipse color=darkgrey label="Statsd\n(optional)"]
  Scheduler [href="#scheduler"]
  Zookeeper [shape=ellipse]
  {
    rank=same;
    Executor [href="#executor"]
    Merger [href="#merger"]
    Nodepool
  }

  Gerrit -> Scheduler [ltail=CodeHosting dir=both];
  Web [href="#web-server"]
  Web -> Database
  Web -> Zookeeper
  Web -> Executor
  Finger -> Executor
  Executor -> Statsd [color=darkgrey]
  Executor -> "Job Node" [label=ssh]
  Nodepool -> "Job Node"

  Scheduler -> Database;
  Scheduler -> Zookeeper;
  Scheduler -> Statsd [color=darkgrey];
  Zookeeper -> Finger;
  Zookeeper -> Merger
  Zookeeper -> Executor;
  Zookeeper -> Nodepool;

  subgraph CodeHosting {
    cluster=true;
    label="Code hosting";
    Gerrit;
    GitHub;
    GitLab;
  }
}
