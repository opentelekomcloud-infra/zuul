// dot -Tpng -ocomponents.png components.dot
digraph {
  compound=true;
  node [shape=box]
  Database [shape=cylinder]
  Finger [href="#finger-gateway"]
  Statsd [shape=ellipse color=darkgrey label="Statsd\n(optional)"]
  Scheduler [href="#scheduler"]
  Zookeeper [shape=cylinder]

  {
    rank=same;
    Executor [href="#executor"]
    Merger [href="#merger"]
    Nodepool
  }

  Scheduler -> Gerrit [lhead=CodeHosting];
  GitHub -> Web [ltail=CodeHosting];
  Web [href="#web-server"]
  Web -> Database
  Web -> Zookeeper
  Web -> Executor
  Web -> Statsd [color=darkgrey]
  Web -> Finger [color=darkgrey label="zoned\nexecutors" fontcolor=darkgrey]
  Finger -> Executor
  Finger -> Zookeeper
  Executor -> Zookeeper
  Executor -> Statsd [color=darkgrey]
  Executor -> "Job Node" [label=ssh]
  Nodepool -> Zookeeper
  Nodepool -> "Job Node"
  Nodepool -> Statsd [color=darkgrey]

  Scheduler -> Database;
  Scheduler -> Zookeeper;
  Scheduler -> Statsd [color=darkgrey];
  Merger -> Zookeeper
  Merger -> Statsd [color=darkgrey]

  subgraph CodeHosting {
    cluster=true;
    label="Code hosting";
    Gerrit;
    GitHub;
    GitLab;
  }
}
