      "key": {
        "uuid": "c4815af1_2c5c0266",
        "filename": "doc/source/developer/specs/reporting-jobs.rst",
        "patchSetId": 1
      },
      "lineNbr": 173,
      "author": {
        "id": 37112
      },
      "writtenOn": "2025-11-21T14:45:24Z",
      "side": 1,
      "message": "Zuul should provide the merge commit SHAs to the reporting jobs for this purpose. Therefore the subproject repositories are not needed for the purpose of updating the superproject. Also the subproject repositories will not provide the post-merge state, but instead the speculative state.",
      "parentUuid": "17b6e225_57fcbbb2",
      "revId": "87005477635d5eb16f258edbde164e9010b1062e",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
    },
