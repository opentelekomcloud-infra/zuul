# Dockerfile for Zuul Web with Gitea driver
FROM swr.eu-de.otc.t-systems.com/t-cloud-public/hardened-zuul-web:14.2.0-v6

USER root

# Copy Gitea driver source files
COPY zuul/driver/gitea/ /usr/lib/python3.13/site-packages/zuul/driver/gitea/
COPY zuul/lib/connections.py /usr/lib/python3.13/site-packages/zuul/lib/connections.py
COPY zuul/configloader.py /usr/lib/python3.13/site-packages/zuul/configloader.py

# Copy GitHub driver fix (merge-mode fallback for missing API fields)
COPY zuul/driver/github/githubconnection.py /usr/lib/python3.13/site-packages/zuul/driver/github/githubconnection.py

# Ensure the zuul user/group exists (hardened base images do not create it)
RUN groupadd -g 10001 zuul 2>/dev/null || true && \
    useradd -u 10001 -g zuul -m -d /var/lib/zuul -c "Zuul Daemon" zuul 2>/dev/null || true && \
    mkdir -p /usr/local/bin && \
    ln -sf /usr/bin/zuul /usr/local/bin/zuul && \
    ln -sf /usr/bin/zuul-web /usr/local/bin/zuul-web

# Ensure proper permissions
RUN chown -R zuul:zuul /usr/lib/python3.13/site-packages/zuul/driver/gitea/ && \
    chown zuul:zuul /usr/lib/python3.13/site-packages/zuul/lib/connections.py && \
    chown zuul:zuul /usr/lib/python3.13/site-packages/zuul/configloader.py && \
    chown zuul:zuul /usr/lib/python3.13/site-packages/zuul/driver/github/githubconnection.py && \
    chmod 644 /usr/lib/python3.13/site-packages/zuul/driver/gitea/*.py && \
    chmod 644 /usr/lib/python3.13/site-packages/zuul/lib/connections.py && \
    chmod 644 /usr/lib/python3.13/site-packages/zuul/configloader.py && \
    chmod 644 /usr/lib/python3.13/site-packages/zuul/driver/github/githubconnection.py

USER zuul

# Verify driver can be imported
RUN python3 -c "from zuul.driver.gitea import GiteaDriver; print('Gitea driver loaded successfully')"
