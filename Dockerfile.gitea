# Dockerfile for Zuul with Gitea driver
# Based on existing OTC Zuul image

FROM quay.io/opentelekomcloud/zuul-scheduler:13.1.1

USER root

# Fix security vulnerabilities by upgrading packages
RUN pip3 install --upgrade --no-cache-dir \
    'pip>=25.3' \
    'setuptools>=78.1.1' \
    'wheel>=0.46.2' \
    'urllib3>=2.6.3' \
    'pyasn1>=0.6.2' \
    'protobuf>=6.0.0'

# Copy Gitea driver source files
COPY zuul/driver/gitea/ /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/
COPY zuul/lib/connections.py /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py
COPY zuul/configloader.py /usr/local/lib/python3.11/site-packages/zuul/configloader.py

# Ensure proper permissions
RUN chown -R zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/ && \
    chown zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py && \
    chown zuul:zuul /usr/local/lib/python3.11/site-packages/zuul/configloader.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/driver/gitea/*.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/lib/connections.py && \
    chmod 644 /usr/local/lib/python3.11/site-packages/zuul/configloader.py

USER zuul

# Verify driver can be imported
RUN python3 -c "import zuul.driver.gitea; print('Gitea driver loaded successfully')"
